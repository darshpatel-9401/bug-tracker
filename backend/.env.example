# Copy to .env for local work. In production, set these as environment variables on your host.
ENVIRONMENT=development
# Local SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql://bugtracker:bugtracker@localhost:5432/bugtracker
DATABASE_URL=sqlite:///./bugtracker.db
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_MINUTES=60
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
